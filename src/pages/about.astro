---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { siteConfig } from '../config';

const { businessName, phone, siteUrl, serviceKeyword, city, cities, services } = siteConfig;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": `${siteUrl}/about/` },
  ],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": `About ${businessName}`,
  "description": `${businessName} provides kitchen cabinet refacing in ${city}.`,
  "mainEntity": {
    "@type": "LocalBusiness",
    "name": businessName,
    "telephone": siteConfig.phoneE164,
  },
};
---

<BaseLayout
  title={`About Us | ${businessName}`}
  description={`${businessName} refaces kitchen cabinets and vanities in Florence, Covington, Fort Thomas, Newport, and across Northern Kentucky. How it works, what's included, and where we go.`}
  canonicalURL={`${siteUrl}/about/`}
  schema={[breadcrumbSchema, aboutPageSchema]}
>

<section class="hero-section">
  <div class="container">
    <h1>About {businessName}</h1>
    <p class="hero-sub">Kitchen cabinet refacing for Northern Kentucky homes.</p>
    <PhoneCTA />
  </div>
</section>

<div class="container py-6 text-center">
  <img
    src="/photos/team.jpg"
    alt="Cabinet refacing crew"
    class="site-photo mx-auto max-w-2xl"
    loading="eager"
  />
</div>

<div class="content-section">
  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4">What We Do</h2>

  <p>Cabinet refacing replaces the parts of your cabinets you see and touch — doors, drawer fronts, and hardware — while keeping the existing cabinet boxes. It typically costs 50-70% less than full replacement and most kitchens are done in 3-5 days, compared to 4-8 weeks for a full remodel.</p>

  <ul>
    {services.map((s) => (
      <li><strong>{s.title}</strong> — {s.description}</li>
    ))}
  </ul>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">How a Job Works</h2>

  <p><strong>1. Quote.</strong> Call {phone} or send the form. Tell us roughly how many cabinets and drawers you have, the style and color you're after, and whether you want upgrades like soft-close hinges or pull-out shelves.</p>

  <p><strong>2. Check the boxes.</strong> Refacing works best when the existing cabinet boxes are structurally sound. If any are damaged, repair or replacement options are discussed before work starts.</p>

  <p><strong>3. Installation.</strong> New doors, drawer fronts, and hardware go on over 3-5 days. Before the crew leaves, walk through the kitchen with them.</p>

  <h2 class="text-brand text-xl md:text-2xl font-bold mb-4 mt-8">Where We Work</h2>

  <p>Our main service areas are {cities.map((c) => c.name.replace(/, KY$/, '')).join(', ')}:</p>

  <ul>
    {cities.map((c) => (
      <li><a href={`/cabinet/${c.slug}/`}>Cabinet refacing in {c.name}</a></li>
    ))}
  </ul>

  <p>Close by but not on the list? Call {phone} and ask — nearby towns are often fine.</p>
</div>

<section class="bg-gray-50 border-y-2 border-brand">
  <div class="cta-strip container">
    <p class="cta-heading">Ready to Get Your Cabinets Refaced?</p>
    <p class="cta-sub">Call now for a free {serviceKeyword} estimate.</p>
    <PhoneCTA />
  </div>
</section>

</BaseLayout>
